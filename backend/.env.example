# Flask Secret & JWT Keys
SECRET_KEY=smart-campus-iq-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=jwt-super-secret-key-smart-campus-iq-2026
JWT_ACCESS_EXPIRES_HOURS=12

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_campus_iq?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_campus_iq
USE_MOCK_DB_IF_UNAVAILABLE=true

# Twilio SMS Configuration (Railway Environment Variables)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# SMS Mode: "demo" (safe simulation) or "live" (sends real SMS via Twilio)
SMS_MODE=demo

# CORS Frontend Domain
FRONTEND_URL=*
PORT=5000

# College Metadata
COLLEGE_NAME=Institute of Technology & Advanced Engineering (ITAE)
COLLEGE_SHORT=ITAE
